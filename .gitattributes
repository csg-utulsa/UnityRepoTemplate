# =========================================================
# Unity Comprehensive .gitattributes
# Covers: Merge strategies, diff behavior, Git LFS,
# and GitHub linguist configuration
# =========================================================


# =========================================================
# 🔧 ATTRIBUTE MACROS (DEFINE REUSABLE RULES)
# =========================================================

# Git LFS macro:
# - Stores large files outside Git history
# - Prevents repo bloat
[attr]lfs               filter=lfs diff=lfs merge=lfs -text

# Unity JSON files:
# - Normalize line endings
# - Improves GitHub language detection
[attr]unity-json        eol=lf linguist-language=json

# Unity YAML files:
# - Uses Unity Smart Merge (unityyamlmerge)
# - Prevents merge conflicts in scenes/prefabs
[attr]unity-yaml        merge=unityyamlmerge eol=lf linguist-language=yaml

# Optional: collapse YAML diffs on GitHub (less readable but cleaner PRs)
# [attr]unity-yaml        merge=unityyamlmerge text linguist-language=yaml linguist-generated


