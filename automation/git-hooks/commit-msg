#!/bin/sh

COMMIT_MSG_FILE=$1
COMMIT_MSG=$(head -n 1 "$COMMIT_MSG_FILE")

# Allowed past-tense action verbs
VERBS="added|fixed|updated|removed|refactored|documented|tested|configured"

# Pattern: type: short description
PATTERN="^($TYPES): .+"

if ! echo "$COMMIT_MSG" | grep -Eq "$PATTERN"; then
  echo ""
  echo "❌ Invalid commit message format."
  echo ""
  echo "Expected format:"
  echo "  <verb>: <short description>"
  echo ""
  echo "Use a past-tense action verb to describe what you DID:"
  echo ""
  echo "  added       - introduced new functionality or content"
  echo "  fixed       - corrected a bug or unexpected behavior"
  echo "  updated     - modified or improved existing functionality"
  echo "  removed     - deleted functionality, content, or files"
  echo "  refactored  - restructured code without changing behavior"
  echo "  documented  - added or updated documentation"
  echo "  tested      - added or modified tests"
  echo "  configured  - modified project settings or configuration"
  echo ""
  echo "Examples:"
  echo "  added: player movement"
  echo "  fixed: incorrect enemy spawn location"
  echo "  updated: player movement speed"
  echo "  refactored: reorganized AI scripts"
  echo "  documented: player controller settings"
  echo ""
  echo "💡 Tip: Ask yourself — what did I change in this commit?"
  echo ""
  exit 1
fi

exit 0
