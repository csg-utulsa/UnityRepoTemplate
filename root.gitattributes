# =========================================================
# Repo-wide .gitattributes
# Handles text normalization, binaries, and GitHub stats
# =========================================================

# ---------------------------------------------------------
# 🌐 Text normalization (all text files)
# ---------------------------------------------------------
* text=auto
*.txt text
*.md  text
*.csv text
*.json text
*.xml text

# ---------------------------------------------------------
# 📦 Binary files (default)
# ---------------------------------------------------------
*.exe binary
*.dll binary
*.so  binary
*.dylib binary
*.zip binary
*.rar binary
*.7z  binary
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.fbx binary
*.uasset binary
*.umap binary

# ---------------------------------------------------------
# ⚡ Git LFS defaults (optional)
# ---------------------------------------------------------
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.uasset filter=lfs diff=lfs merge=lfs -text

# ---------------------------------------------------------
# 🧹 GitHub linguist (ignore generated code)
# ---------------------------------------------------------
Binaries/** linguist-generated
Builds/** linguist-generated
Docs/** linguist-generated
