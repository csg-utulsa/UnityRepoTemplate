# =========================================================
# Unity Comprehensive .gitignore
# Covers: Generated files, builds, caches, IDE files,
# logs, addressables, and OS junk
# =========================================================


# =========================================================
# 🔧 CORE UNITY GENERATED FOLDERS (NEVER COMMIT)
# =========================================================

# Library: Imported assets cache (can be regenerated)
[Ll]ibrary/

# Temp: Temporary build files
[Tt]emp/

# Obj: Intermediate object files
[Oo]bj/

# Logs: Editor and build logs
[Ll]ogs/

# User-specific settings (local machine only)
[Uu]ser[Ss]ettings/


# =========================================================
# 🏗️ BUILD OUTPUTS (DO NOT COMMIT BUILDS)
# =========================================================

[Bb]uild/
[Bb]uilds/

# Mobile builds
*.apk
*.aab

# Desktop builds
*.app

# Unity package exports
*.unitypackage
*.unitypackage.meta


# =========================================================
# 🧠 GENERATED PROJECT / IDE FILES
# =========================================================

# Visual Studio
.vs/
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# JetBrains Rider
.idea/
*.DotSettings.user

# VS Code
.vscode/

# Consulo
.consulo/

# Unity generated project exports
ExportedObj/


# =========================================================
# ⚙️ CACHE / PACKAGE MANAGER / BUILD SYSTEMS
# =========================================================

# Gradle cache (Android)
.gradle/

# Unity Package Manager artifacts (optional safety)
# Uncomment if needed:
# Packages/packages-lock.json


# =========================================================
# 🧾 LOGS, CRASHES, AND DEBUG FILES
# =========================================================

*.log
sysinfo.txt

# Unity / Mono crash files
mono_crash.*


# =========================================================
# 💾 MEMORY CAPTURES & RECORDINGS (VERY LARGE FILES)
# =========================================================

[Mm]emoryCaptures/
[Rr]ecordings/


# =========================================================
# 🎨 BLENDER / DCC TEMP FILES
# =========================================================

# Blender backups (not needed)
*.blend1
*.blend1.meta


# =========================================================
# 🧪 TEST / AUTO-GENERATED FILES
# =========================================================

# Unity Test Runner
InitTestScene*.unity*

# Play mode test scenes
[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*


# =========================================================
# 📦 ADDRESSABLES (GENERATED CONTENT)
# =========================================================

/ServerData
[Aa]ssets/StreamingAssets/aa*
[Aa]ssets/AddressableAssetsData/link.xml*
[Aa]ssets/Addressables_Temp*

# Addressables build state files
[Aa]ssets/AddressableAssetsData/*/*.bin*


# =========================================================
# 🔌 PLUGINS / GENERATED TOOLING FILES
# =========================================================

# JetBrains Rider plugin (auto-generated)
[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Scripting generated files
[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta


# =========================================================
# 🧾 GENERATED META FILE EDGE CASES
# =========================================================

*.pidb.meta
*.pdb.meta
*.mdb.meta


# =========================================================
# ⚠️ OPTIONAL: ASSET STORE TOOLS
# =========================================================

# Uncomment if you want to ignore Asset Store tools
# [Aa]ssets/AssetStoreTools*


# =========================================================
# 🌍 OS-GENERATED FILES
# =========================================================

# Mac
.DS_Store

# Windows
Thumbs.db
Desktop.ini


# =========================================================
# 🚫 WHAT SHOULD NOT BE IGNORED
# (Ensure these ARE committed to Git)
# =========================================================

# Assets/        -> All game assets (REQUIRED)
# Packages/      -> Package dependencies (REQUIRED)
# ProjectSettings/ -> Project configuration (REQUIRED
# *.meta         -> MUST be tracked for Unity asset linking

# =========================================================
# END OF FILE
# =========================================================
